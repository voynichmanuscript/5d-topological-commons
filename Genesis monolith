class TensegrityLatticeNode:
    """Represents an individual variable-density honeycomb node in the sponge matrix."""
    def __init__(self, node_id: str, elevation_m: float, cell_density_factor: float):
        self.node_id = node_id
        self.elevation_m = elevation_m
        self.cell_density_factor = cell_density_factor  # 1.0 = dense base, 0.2 = open crown macro-pocket
        self.current_tension_mpa = 0.0
        self.current_compression_mpa = 0.0
        self.thermal_displacement_mm = 0.0
        self.locked_status = False

    def calculate_load_response(self, ambient_temp_c: float, wind_shear_knots: float) -> None:
        """Simulates barn-style movement joints responding to thermal shifts and wind."""
        # Calculate thermal expansion based on Invar/BFRP parameters
        delta_temp = ambient_temp_c - 20.0  # Baseline 20°C
        self.thermal_displacement_mm = delta_temp * MaterialConstants.INVAR_THERMAL_EXPANSION_COEFF * self.elevation_m * 1000.0
        
        # Distribute wind shear loads across irregular sponge geometry
        shear_factor = (self.elevation_m / 1200.0) * (wind_shear_knots / 50.0)
        self.current_tension_mpa = 45.0 * self.cell_density_factor * (1.0 + shear_factor)
        self.current_compression_mpa = 120.0 * (2.0 - self.cell_density_factor) * (1.0 + shear_factor * 0.5)

    def apply_keystone_lock(self) -> bool:
        """Locks the tensegrity node into cosmic equilibrium."""
        if self.current_compression_mpa <= MaterialConstants.UHPC_COMPRESSION_LIMIT_MPA:
            self.locked_status = True
            return True
        return False


class AtmosphericHydrologyEngine:
    """Models the 1,200-meter thermal chimney, dew-point flash points, and cascading filtration."""
    def __init__(self, total_height_m: float = 1200.0):
        self.height_m = total_height_m
        self.crown_temp_c = -5.0   # High altitude ambient
        self.base_temp_c = 22.0    # Ground level ambient
        self.daily_harvest_liters = 0.0

    def simulate_thermal_chimney(self, internal_humidity_pct: float) -> Dict[str, float]:
        """Calculates stack-effect air velocity and condensation flash point at the crown."""
        temp_differential = self.base_temp_c - self.crown_temp_c
        # Stack effect velocity proportional to square root of height and temp differential
        air_velocity_ms = math.sqrt(2.0 * 9.81 * (self.height_m) * (temp_differential / (273.15 + self.base_temp_c)))
        
        # Dew-point flash calculation at crown mesh array
        dew_point_c = self.base_temp_c - ((100.0 - internal_humidity_pct) / 5.0)
        flash_efficiency = max(0.0, min(1.0, (self.crown_temp_c <= dew_point_c) * 0.85 + 0.15))
        
        harvest_liters_per_hour = air_velocity_ms * internal_humidity_pct * flash_efficiency * 12.5
        self.daily_harvest_liters = harvest_liters_per_hour * 24.0

        return {
            "stack_velocity_ms": round(air_velocity_ms, 2),
            "crown_dew_point_c": round(dew_point_c, 2),
            "flash_efficiency_pct": round(flash_efficiency * 100.0, 1),
            "estimated_daily_harvest_l": round(self.daily_harvest_liters, 2)
        }

    def calculate_hydraulic_pressure_tiers(self, tiers: int = 12) -> List[Dict[str, float]]:
        """Calculates pressure-break intervals for zero-pump cascading drip channels."""
        tier_height_m = self.height_m / tiers
        pressure_profile = []
        for i in range(tiers):
            current_elevation = self.height_m - (i * tier_height_m)
            # Hydrostatic pressure P = rho * g * h (approx 9.8 kPa per meter)
            hydrostatic_kPa = (tier_height_m * 9.8) * (i + 1)
            pressure_profile.append({
                "tier": i + 1,
                "elevation_m": round(current_elevation, 1),
                "break_tank_pressure_kPa": round(hydrostatic_kPa, 2),
                "filtration_media": "Sub-surface flow biochar & expanded clay"
            })
        return pressure_profile


