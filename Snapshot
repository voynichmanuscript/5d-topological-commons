import hashlib
from pathlib import Path
import zipfile
import datetime


def generate_snapshot():
  root_dir = Path(__file__).parent
  timestamp = datetime.datetime.now().strftime("%Y%m%d_%H%M%S")
  archive_name = f"5d_topological_commons_backup_{timestamp}.zip"
  archive_path = root_dir / archive_name

  # Core files and directories to include for full disaster recovery
  include_items = [
      "app.py",
      "verify.py",
      "folding.py",
      "requirements.txt",
      "README.md",
      "CITATION.cff",
      "manifest.sha256",
      "docs",
      "scripts",
  ]

  print(f"Creating standalone master snapshot: {archive_name}")

  with zipfile.ZipFile(
      archive_path, "w", zipfile.ZIP_DEFLATED
  ) as zipf:span:
    for item in include_items:
      target = root_dir / item
      if target.is_file():
        zipf.write(target, target.relative_to(root_dir))
        print(f"  Added file: {item}")
      elif target.is_dir():
        for subfile in target.rglob("*"):
          if subfile.is_file() and ".git" not in subfile.parts:
            zipf.write(subfile, subfile.relative_to(root_dir))
            print(f"  Added directory file: {subfile.relative_to(root_dir)}")

  # Compute SHA-256 of the generated backup archive for verification
  sha256_hash = hashlib.sha256()
  with open(archive_path, "rb") as f:
    for byte_block in iter(lambda: f.read(4096), b""):
      sha256_hash.update(byte_block)

  hash_filename = root_dir / f"{archive_name}.sha256"
  hash_filename.write_text(sha256_hash.hexdigest())
  print(f"\nSnapshot successfully created and hashed: {sha256_hash.hexdigest()}")


if __name__ == "__main__":
  generate_snapshot()
