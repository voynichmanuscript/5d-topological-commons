            "earth": sim_earth_sheltered_structure(
                wall_thickness_m=0.25, airflow_m3_hr=260.0, outdoor_swing_c=20.0, peak_ambient_c=35.0
            ),
            "tlud": sim_tlud_biochar_reactor(
                biomass_kg=12.0, moisture_pct=32.0, burner_thermal_eff=0.45
            ),
            "hydro": sim_low_head_river_retrofit(
                head_m=1.1,
                total_flow_m3s=0.22,
                bypass_fraction=0.20,
                head_loss_m=0.22,
