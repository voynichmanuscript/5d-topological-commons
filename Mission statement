def _clamp(value: float, low: float, high: float) -> float:
    """Clamp a finite numeric value safely into [low, high]."""
    if low > high:
        raise ValueError(f"Lower bound ({low}) cannot exceed upper bound ({high}).")
    num = float(value)
    if num != num:  # Guard against NaN
        raise ValueError("Numeric value cannot be NaN.")
    if num < low:
        return float(low)
    if num > high:
        return float(high)
    return num


def _require_non_empty_str(text: str, field_name: str) -> str:
    if not isinstance(text, str) or not text.strip():
        raise ValueError(f"{field_name} must be a non-empty string.")
    return text.strip()


def _require_non_negative(value: float, name: str) -> float:
    num = float(value)
    if num != num or num < 0.0:
        raise ValueError(f"{name} must be a non-negative number; got {value!r}.")
    return num


def _require_positive(value: float, name: str) -> float:
    num = float(value)
    if num != num or num <= 0.0:
        raise ValueError(f"{name} must be a positive number; got {value!r}.")
    return num


@dataclass
class StewardshipItem:
    """
    Represents an existing material, habit, subsystem, or overlooked resource.
    Scores are normalized to [0.0, 1.0].
    """

    name: str
    utility: float
    friction: float
    adaptability: float
    status: str = "in-place"
    history: List[str] = field(default_factory=list)

    def __post_init__(self) -> None:
        self.name = _require_non_empty_str(self.name, "Item name")
        self.utility = _clamp(self.utility, 0.0, 1.0)
        self.friction = _clamp(self.friction, 0.0, 1.0)
        self.adaptability = _clamp(self.adaptability, 0.0, 1.0)
        self.status = _require_non_empty_str(self.status, "Item status")

    def record(self, note: str) -> None:
        clean_note = _require_non_empty_str(note, "History note")
        self.history.append(clean_note)


@dataclass(frozen=True)
class StewardshipDecision:
    """Immutable record of one ethical evaluation & stewardship action."""

    item_name: str
    target_space: str
    action: str
    treasure_score: float
    treasure_recovered: float
    bounded_trash: float
    backbone_cohesion: float
    damage_reversal_index: float


class EthicalStewardshipEngine:
    """
    Encodes the core stewardship ethic:
      1. Look for treasure before declaring trash.
      2. Retrofit, adjust, and refine in-place components into new spaces.
      3. Hold the whole system together rather than fracturing living connections.
      4. Accept bounded residual waste honestly when full recovery is not possible.
    """

    def __init__(
        self,
        initial_cohesion: float = 0.82,
        initial_damage_reversal: float = 0.15,
    ) -> None:
        self.backbone_cohesion: float = _clamp(initial_cohesion, 0.0, 1.0)
        self.damage_reversal_index: float = _clamp(initial_damage_reversal, 0.0, 1.0)
        self.total_treasure_recovered: float = 0.0
        self.total_bounded_trash: float = 0.0
        self.ledger: Dict[str, StewardshipItem] = {}
        self.decisions: List[StewardshipDecision] = []

    def scan_for_treasure(self, item: StewardshipItem) -> float:
        """
        First step: evaluate latent value, adaptability, and salvageable potential
        even when initial friction is high or the component is out of favor.
        """
        raw_score = (
            0.40 * item.utility
            + 0.40 * item.adaptability
            + 0.20 * (1.0 - 0.5 * item.friction)
        )
        return round(_clamp(raw_score, 0.0, 1.0), 4)

    def refine_item(self, item: StewardshipItem, target_space: str) -> None:
        """
        Adjust and refine an existing component so it can serve in target_space
        instead of being discarded out of hand.
        """
        clean_space = _require_non_empty_str(target_space, "Target space")
        gain = 0.12 + 0.10 * item.adaptability
        friction_reduction = 0.14 + 0.12 * item.adaptability

        item.utility = round(_clamp(item.utility + gain, 0.0, 1.0), 4)
        item.friction = round(_clamp(item.friction - friction_reduction, 0.0, 1.0), 4)
        item.adaptability = round(_clamp(item.adaptability + 0.03, 0.0, 1.0), 4)
        item.status = f"refined-in:{clean_space}"
        item.record(
            f"Retrofitted into '{clean_space}' (utility={item.utility:.2f}, "
            f"friction={item.friction:.2f})"
        )

    def steward_item(
        self,
        item: StewardshipItem,
        target_space: str = "living-monolith-system",
        max_refine_passes: int = 2,
    ) -> StewardshipDecision:
        """
        Apply the stewardship sequence to an item and update whole-system health.
        """
        if max_refine_passes < 1:
            raise ValueError("max_refine_passes must be at least 1.")
        clean_space = _require_non_empty_str(target_space, "Target space")

        treasure_score = self.scan_for_treasure(item)

        # Prioritize retrofitting and refinement whenever adaptability or latent value is viable
        if item.adaptability >= 0.25 or treasure_score >= 0.48:
            passes = max_refine_passes if item.friction >= 0.65 else 1
            for _ in range(passes):
                self.refine_item(item, clean_space)

            treasure_recovered = round(
                _clamp(treasure_score * (0.75 + 0.20 * item.utility), 0.0, 1.0), 4
            )
            bounded_trash = round(
                _clamp(item.friction * (1.0 - 0.65 * item.adaptability) * 0.40, 0.0, 1.0),
                4,
            )
            action = "RETROFIT_AND_REFINE"
            cohesion_delta = 0.04 * treasure_recovered - 0.03 * bounded_trash
            reversal_delta = 0.05 * treasure_recovered - 0.02 * bounded_trash
        else:
            # Honest acceptance: acknowledge unrecoverable friction as bounded residual waste
            treasure_recovered = round(_clamp(treasure_score * 0.20, 0.0, 1.0), 4)
            bounded_trash = round(_clamp(0.15 + 0.55 * item.friction, 0.0, 1.0), 4)
            item.status = "bounded-residual-trash"
            item.record(
                f"Honest residual accounting in '{clean_space}' (residual={bounded_trash:.2f})"
            )
            action = "ACCEPT_BOUNDED_RESIDUAL"
            cohesion_delta = 0.01 * treasure_recovered - 0.025 * bounded_trash
            reversal_delta = 0.015 * treasure_recovered - 0.015 * bounded_trash

        self.total_treasure_recovered = round(
            self.total_treasure_recovered + treasure_recovered, 4
        )
        self.total_bounded_trash = round(self.total_bounded_trash + bounded_trash, 4)
        self.backbone_cohesion = round(
            _clamp(self.backbone_cohesion + cohesion_delta, 0.0, 1.0), 4
        )
        self.damage_reversal_index = round(
            _clamp(self.damage_reversal_index + reversal_delta, 0.0, 1.0), 4
        )
        self.ledger[item.name] = item

        decision = StewardshipDecision(
            item_name=item.name,
            target_space=clean_space,
            action=action,
            treasure_score=treasure_score,
            treasure_recovered=treasure_recovered,
            bounded_trash=bounded_trash,
            backbone_cohesion=self.backbone_cohesion,
            damage_reversal_index=self.damage_reversal_index,
        )
        self.decisions.append(decision)
        return decision


@dataclass(frozen=True)
class PhysicalStageReport:
    """Deterministic step output for one physical stage of the Monolith."""

    stage_id: str
    label: str
    stored: float
    capacity: float
    accepted: float
    overflow: float
    bypassed: bool
    notes: str


class PhysicalStage:
    """
    Bounded physical stage with strict input validation, safe bypass rerouting,
    and predictable overflow tracking.
    """

    def __init__(
        self,
        stage_id: str,
        label: str,
        capacity: float,
        initial_stored: float = 0.0,
        notes: str = "",
    ) -> None:
        self.stage_id: str = _require_non_empty_str(stage_id, "Stage ID")
        self.label: str = _require_non_empty_str(label, "Stage label")
        self.capacity: float = _require_positive(capacity, f"Stage '{stage_id}' capacity")
        clean_initial = _require_non_negative(
            initial_stored, f"Stage '{stage_id}' initial_stored"
        )
        self.stored: float = round(min(clean_initial, self.capacity), 4)
        self.bypassed: bool = False
        self.notes: str = notes.strip()

    def set_bypass(self, bypass: bool) -> None:
        self.bypassed = bool(bypass)

    def advance(self, inflow: float) -> PhysicalStageReport:
        clean_inflow = _require_non_negative(inflow, f"Stage '{self.stage_id}' inflow")

        if self.bypassed:
            return PhysicalStageReport(
                stage_id=self.stage_id,
                label=self.label,
                stored=round(self.stored, 4),
                capacity=round(self.capacity, 4),
                accepted=0.0,
                overflow=round(clean_inflow, 4),
                bypassed=True,
                notes=self.notes,
            )

        headroom = max(0.0, self.capacity - self.stored)
        accepted = min(clean_inflow, headroom)
        overflow = max(0.0, clean_inflow - accepted)
        self.stored = round(_clamp(self.stored + accepted, 0.0, self.capacity), 4)

        return PhysicalStageReport(
            stage_id=self.stage_id,
            label=self.label,
            stored=round(self.stored, 4),
            capacity=round(self.capacity, 4),
            accepted=round(accepted, 4),
            overflow=round(overflow, 4),
            bypassed=False,
            notes=self.notes,
        )


class GenesisMonolithAssembly:
    """
    Models the coupled real-world physical assemblies of The Genesis Monolith:
      - U-trap water-lock & anaerobic settling tank
      - Subsurface biochar & wetland reed biofilter
      - Stepped stone-and-clay live pools (frost-decoupled rim & drain shoulder)
      - Conical gas collector/scrubber feeding a slide-gasket algae viewing bay
        with opposite-wall tension braces, bypass reroute valve, and winch rail
      - Subterranean counter-current tunnel with cool wall condensation, drain
        trough, and dedicated separated exhaust flue
      - Condensate & return collection basin
    """

    def __init__(self) -> None:
        self.water_lock_sealed: bool = True
        self.exhaust_flue_isolated: bool = True
        self.winch_engaged: bool = False
        self.tension_braces_engaged: bool = True
        self.tick_count: int = 0

        self.stages: Dict[str, PhysicalStage] = {
            "anaerobic_tank": PhysicalStage(
                "anaerobic_tank",
                "U-Trap Water-Lock & Anaerobic Tank",
                capacity=300.0,
                initial_stored=60.0,
                notes="Liquid U-trap seal + solids settling & gas dome feed",
            ),
            "biochar_reed_bed": PhysicalStage(
                "biochar_reed_bed",
                "Biochar & Reed Biofilter Bed",
                capacity=360.0,
                initial_stored=50.0,
                notes="Subsurface gravel, biochar sorption, and wetland reed root zone",
            ),
            "live_pools": PhysicalStage(
                "live_pools",
                "Stepped Stone-and-Clay Live Pools",
                capacity=500.0,
                initial_stored=140.0,
                notes="Frost-decoupled rim, gravel drain shoulder, wide stone weirs",
            ),
            "algae_viewing_bay": PhysicalStage(
                "algae_viewing_bay",
                "Gas-Fed Algae Viewing Chamber",
                capacity=200.0,
                initial_stored=40.0,
                notes="Scrubbed CO2 feed, slide-fit gasket, tension braces, winch rail",
            ),
            "condensation_tunnel": PhysicalStage(
                "condensation_tunnel",
                "Counter-Current Condense Tunnel",
                capacity=400.0,
                initial_stored=55.0,
                notes="Warm rising air, cool stone condensate trough, separated exhaust flue",
            ),
            "collection_basin": PhysicalStage(
                "collection_basin",
                "Condensate & Return Basin",
                capacity=600.0,
                initial_stored=80.0,
                notes="Collects cool-wall condensate and controlled system return",
            ),
        }

    def set_algae_bay_service(self, service_active: bool) -> None:
        """
        Engage or release service mode on the algae viewing module:
        reroutes flow through bypass, disengages tension braces for removal,
        and engages the overhead winch rail.
        """
        active = bool(service_active)
        self.stages["algae_viewing_bay"].set_bypass(active)
        self.winch_engaged = active
        self.tension_braces_engaged = not active

    def step(
        self,
        raw_inflow: float,
        scrubbed_gas_feed: float,
        ambient_moisture_load: float,
        passive_cycle_draw: float = 6.0,
    ) -> Dict[str, PhysicalStageReport]:
        """Advance all coupled physical stages deterministically by one tick."""
        inflow = _require_non_negative(raw_inflow, "raw_inflow")
        gas = _require_non_negative(scrubbed_gas_feed, "scrubbed_gas_feed")
        moisture = _require_non_negative(ambient_moisture_load, "ambient_moisture_load")
        draw = _require_non_negative(passive_cycle_draw, "passive_cycle_draw")

        self.tick_count += 1

        r_tank = self.stages["anaerobic_tank"].advance(inflow)
        r_bed = self.stages["biochar_reed_bed"].advance(
            r_tank.accepted * 0.85 + r_tank.overflow
        )
        r_pools = self.stages["live_pools"].advance(
            r_bed.accepted * 0.90 + r_bed.overflow
        )
        r_algae = self.stages["algae_viewing_bay"].advance(gas)

        tunnel_feed = moisture + r_pools.overflow + r_algae.overflow
        r_tunnel = self.stages["condensation_tunnel"].advance(tunnel_feed)

        basin_feed = r_tunnel.accepted * 0.80 + r_tunnel.overflow
        r_basin = self.stages["collection_basin"].advance(basin_feed)

        # Gentle biological/evaporative draw keeps internal storage from locking full
        step_draw = draw * 0.25
        for stage in self.stages.values():
            stage.stored = round(max(0.0, stage.stored - step_draw), 4)

        return {
            "anaerobic_tank": r_tank,
            "biochar_reed_bed": r_bed,
            "live_pools": r_pools,
            "algae_viewing_bay": r_algae,
            "condensation_tunnel": r_tunnel,
            "collection_basin": r_basin,
        }

    def mechanical_status(self) -> Dict[str, bool | int]:
        return {
            "tick": self.tick_count,
            "water_lock_sealed": self.water_lock_sealed,
            "exhaust_flue_isolated": self.exhaust_flue_isolated,
            "winch_engaged": self.winch_engaged,
            "tension_braces_engaged": self.tension_braces_engaged,
        }


def format_stage_table(title: str, reports: Dict[str, PhysicalStageReport]) -> str:
    header = [
        f"--- {title} ---",
        f"{'STAGE':36} | {'MODE':6} | {'STORED / CAP':17} | {'IN':6} | {'OVF':6}",
        "-" * 83,
    ]
    rows: List[str] = []
    for rep in reports.values():
        mode = "BYPASS" if rep.bypassed else "ACTIVE"
        rows.append(
            f"{rep.label:36} | {mode:6} | "
            f"{rep.stored:7.2f}/{rep.capacity:7.2f} | "
            f"{rep.accepted:6.2f} | {rep.overflow:6.2f}"
        )
    return "\n".join(header + rows)


