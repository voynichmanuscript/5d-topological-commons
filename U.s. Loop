    parser = argparse.ArgumentParser(description="Master Vactrain & Floating-Ladder Engineering Package")
    parser.add_argument("--readme", action="store_true", help="Print embedded README specification and exit")
    args = parser.parse_args(argv)
    if args.readme:
        print(README_MARKDOWN)
        return 0
    print(json.dumps(build_master_bundle(), indent=2))
    return 0


