import numpy as np

def apply_secondary_folding(node_count, phi=1.618):
    """
    Applies a secondary topological folding across the 144-node FSM 
    using the golden ratio (phi) coefficient.
    """
    base_matrix = np.linspace(0, 360, node_count)
    folded = base_matrix * (1.0 / phi)
    return np.sin(np.radians(folded))
