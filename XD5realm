# ---------------------------------------------------------------------
Utility Functions: Deployment & Snapshot Export
# ---------------------------------------------------------------------
def deploy_files():
    print("[*] Deploying master repository files locally...")
    for filename, content in FILES.items():
        with open(filename, "w", encoding="utf-8") as f:
            f.write(content.strip() + "\n")
        print(f"    -> Written: {filename}")

def generate_manifest():
    print("[*] Generating cryptographic SHA-256 manifest...")
    manifest_lines = []
    for filename in sorted(FILES.keys()):
        if os.path.exists(filename):
            with open(filename, "rb") as f:
                file_hash = hashlib.sha256(f.read()).hexdigest()
                manifest_lines.append(f"{file_hash}  {filename}")
    
    manifest_content = "\n".join(manifest_lines) + "\n"
    with open("manifest.sha256", "w", encoding="utf-8") as f:
        f.write(manifest_content)
    print("    -> Written: manifest.sha256")

def export_master_snapshot():
    timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")
    zip_filename = f"5d_voynich_snapshot_{timestamp}.zip"
    
    all_targets = list(FILES.keys()) + ["manifest.sha256"]
    
    print(f"[*] Creating archival snapshot zip: {zip_filename}")
    with zipfile.ZipFile(zip_filename, 'w', zipfile.ZIP_DEFLATED) as zipf:
        for file in all_targets:
            if os.path.exists(file):
                zipf.write(file)
                print(f"    [+] Bundled: {file}")
            else:
                print(f"    [-] Skipped (Missing): {file}")
                
    print(f"[+] Master Snapshot Complete: {zip_filename}")

if __name__ == "__main__":
    deploy_files()
    generate_manifest()
    export_master_snapshot()

