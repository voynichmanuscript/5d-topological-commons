# 5. PHOTO PACKER (EMBEDS ALL 14 PHOTOS INTO A STANDALONE .PY SCRIPT)
# ==============================================================================
def pack_photos_into_self(photo_dir: Path, output_script: Path) -> None:
    """
    Reads up to 14 image files (.jpg/.jpeg/.png/.webp) from `photo_dir`,
    encodes them as verified Base64 payloads, and writes a new standalone
    Python script with every image permanently embedded inside.
    """
    valid_exts = {".jpg", ".jpeg", ".png", ".webp"}
    candidates = sorted(
        [p for p in photo_dir.iterdir() if p.is_file() and p.suffix.lower() in valid_exts]
    )
    if not candidates:
        raise FileNotFoundError(f"No .jpg/.png/.webp files found in: {photo_dir}")

    packed: Dict[str, Dict[str, str]] = {}
    for idx, plate in enumerate(PLATE_MANIFEST):
        if idx >= len(candidates):
            break
        img_path = candidates[idx]
        raw = img_path.read_bytes()
        ext = "png" if img_path.suffix.lower() == ".png" else "jpg"
        packed[plate["id"]] = {
            "ext": ext,
            "filename": img_path.name,
            "sha256": hashlib.sha256(raw).hexdigest(),
            "b64": base64.b64encode(raw).decode("ascii"),
        }

    source_text = Path(__file__).read_text(encoding="utf-8")
    marker = "EMBEDDED_PLATES: Dict[str, Dict[str, str]] = {}"
    if marker not in source_text:
        raise RuntimeError("Template marker not found in script source.")

    serialized = "EMBEDDED_PLATES: Dict[str, Dict[str, str]] = " + json.dumps(packed, indent=2)
    bundled_source = source_text.replace(marker, serialized, 1)
    output_script.write_text(bundled_source, encoding="utf-8")
    print(f"[SUCCESS] Embedded {len(packed)} photos into standalone script: {output_script}")


