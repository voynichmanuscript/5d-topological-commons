    for pid, entry in EMBEDDED_PLATES.items():
        raw = base64.b64decode(entry["b64"])
        digest = hashlib.sha256(raw).hexdigest()
        assert digest == entry["sha256"], f"SHA-256 mismatch on {pid}"
    mode_label = (
        f"{len(EMBEDDED_PLATES)} embedded photo payloads verified"
        if EMBEDDED_PLATES
        else "14 procedural PNG generators active (use --pack <dir> to embed photos)"
    )
    report.append(f"[OK] Visual plate pipeline verified ({mode_label}).")
    return True, report


