def simulate_bifurcation(steps: int = 8) -> List[Dict[str, object]]:
    """Models 0 + 1 -> 2 primary splitting with rare 3-way triple junctions."""
    state_count = 1
    history = [{"step": 0, "states": 0, "event": "0-State Void / Equilibrium"}]
    for s in range(1, steps + 1):
        if s == 1:
            event = "1-State Spark injected into 0-State (0 + 1 -> 1)"
        elif s % 4 == 0:
            state_count = state_count * 2 + 1
            event = "Bifurcation + Isotropic Triple Junction (2x + 1)"
        else:
            state_count *= 2
            event = "Minimum-Energy Binary Bifurcation (x2)"
        history.append({"step": s, "states": state_count, "event": event})
    return history


