    """Runs automated self-checks to guarantee clean, error-free execution."""
    report: List[str] = []
    # Check 1: Arithmetic & exponent identities
    assert (0 + 42 == 42) and (1 * 42 == 42) and (5 ** 0 == 1), "Identity check failed"
    report.append("[OK] Level 1-3 Arithmetic, Placeholder & Exponent identities verified.")

    # Check 2: Boolean logic gates
    assert (int(not 0) == 1) and ((1 & 0) == 0) and ((1 | 0) == 1) and ((1 ^ 0) == 1)
    report.append("[OK] Level 4 Boolean logic gates (NOT, AND, OR, XOR) verified.")

    # Check 3: Qubit normalization |alpha|^2 + |beta|^2 = 1
    alpha, beta = 1.0 / math.sqrt(2.0), 1.0 / math.sqrt(2.0)
    assert math.isclose(abs(alpha) ** 2 + abs(beta) ** 2, 1.0, rel_tol=1e-12)
