class LayerNode:
    def __init__(self, stage, state, trigger, fold_link, output):
        self.stage = stage
        self.state = state
        self.trigger = trigger
        self.fold_link = fold_link
        self.output = output

    def summary(self):
        return (
            f"[{self.stage}] State={self.state} | Trigger={self.trigger} "
            f"| Fold={self.fold_link} -> Out={self.output}"
        )


